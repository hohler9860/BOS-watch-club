# Supabase — get these from your Supabase project dashboard
# Settings → API → Project URL and anon/public key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Notion — content sync (optional, omit to keep hardcoded data)
# Create an integration at https://www.notion.so/my-integrations
# Then share each database with the integration
NOTION_API_KEY=secret_your-notion-api-key
NOTION_EVENTS_DB_ID=your-events-database-id
NOTION_BLOG_DB_ID=your-blog-database-id
NOTION_NEWS_DB_ID=your-news-database-id
