# Supabase — get these from your Supabase project dashboard
# Settings → API → Project URL and anon/public key
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Stripe — payment processing
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your-secret-key
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-signing-secret

# Resend — transactional emails
# Sign up at https://resend.com, verify your domain, then create an API key
RESEND_API_KEY=re_your-resend-api-key

# Supabase service role key — used by webhook to update user profiles
# Get from Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Sentry — error tracking (optional, omit to disable)
# Create a project at https://sentry.io and copy the DSN
VITE_SENTRY_DSN=https://your-dsn@sentry.io/your-project-id

# Notion — content sync (optional, omit to keep hardcoded data)
# Create an integration at https://www.notion.so/my-integrations
# Then share each database with the integration
NOTION_API_KEY=secret_your-notion-api-key
NOTION_EVENTS_DB_ID=your-events-database-id
NOTION_BLOG_DB_ID=your-blog-database-id
NOTION_NEWS_DB_ID=your-news-database-id

# Supabase Edge Functions (auto-injected in production, needed for local dev)
# Same URL as VITE_SUPABASE_URL — edge functions read this name at runtime
SUPABASE_URL=https://your-project.supabase.co

# Typeform — application form
# Webhook signature secret from Typeform → Connect → Webhooks
WEBHOOK_SECRET=your-typeform-webhook-secret
# Base URL of your Typeform (without query params)
TYPEFORM_URL=https://your-typeform-id.typeform.com/to/your-form-id

# Admin secret — used to authenticate review-application edge function
ADMIN_SECRET=your-admin-secret

# Email sender address for edge functions
FROM_EMAIL=BOS Watch Club <hello@boswatchclub.com>
